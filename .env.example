# Connection string do PostgreSQL (local ou de um projeto Supabase).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluxojr"

# Supabase (Project Settings > API). Sem essas variáveis o app roda sem
# autenticação (modo aberto), útil para desenvolvimento local.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
