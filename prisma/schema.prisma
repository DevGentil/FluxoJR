// Prisma schema - Sistema de Fluxo de Caixa (FluxoJR)
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntryType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  IMPORT
  SCHEDULED
}

enum ScheduledType {
  PAYABLE
  RECEIVABLE
}

enum ScheduledStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum CashClosingLineType {
  SANGRIA
  PAGAMENTO
}

// Marca/franquia da holding, agrupando várias empresas/unidades (ex:
// "AmorSaude" agrupa as franquias AS Laguna, AS Contagem, etc.).
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
}

// Empresa/unidade da holding (ex: uma franquia específica). Pode pertencer
// a um Group (marca) ou ficar solta.
model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  accounts            Account[]
  categories          Category[]
  suppliers           Supplier[]
  transactions        Transaction[]
  scheduledEntries    ScheduledEntry[]
  importBatches       ImportBatch[]
  documents           Document[]
  cashClosings        CashClosing[]
  dreReports          DreReport[]
  doctors             Doctor[]
  serviceItems        ServiceItem[]
  taxBrackets         TaxBracket[]
  doctorPeriodReports DoctorPeriodReport[]

  incomingTransfers Transaction[] @relation("TransactionTransfer")
}

// Arquivo qualquer (contrato, documento societário, etc.) anexado a uma
// empresa. Conteúdo guardado direto no Postgres por simplicidade — sem
// depender de um storage externo configurado.
model Document {
  id          String   @id @default(cuid())
  fileName    String
  mimeType    String
  size        Int
  description String
  content     Bytes
  createdAt   DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// DRE realizado (fechado pelo contador/financeiro, ex: em Excel ou PDF) de
// um mês específico, guardado como referência ao lado do DRE que o sistema
// calcula automaticamente a partir das transações lançadas.
model DreReport {
  id          String   @id @default(cuid())
  competencia DateTime // primeiro dia do mês de referência
  fileName    String
  mimeType    String
  size        Int
  notes       String?
  content     Bytes
  createdAt   DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, competencia])
  @@index([companyId])
}

// Fornecedor/cliente da empresa, para enriquecer transações e contas a
// pagar/receber (ex: "DB Medicina Diagnóstica", "Amor Saude Franqueadora").
model Supplier {
  id        String   @id @default(cuid())
  name      String
  document  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  scheduledEntries ScheduledEntry[]
}

model Account {
  id             String   @id @default(cuid())
  name           String
  bank           String?
  type           String   @default("Conta Corrente")
  initialBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  scheduledEntries ScheduledEntry[]
  cashClosings     CashClosing[]
}

model Category {
  id         String    @id @default(cuid())
  name       String
  type       EntryType
  costCenter String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  scheduledEntries ScheduledEntry[]
}

model Transaction {
  id          String            @id @default(cuid())
  date        DateTime
  amount      Decimal           @db.Decimal(14, 2)
  type        EntryType
  description String
  source      TransactionSource @default(MANUAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Marca esta transação como uma transferência de/para outra empresa do
  // grupo (ex: repasse entre franquias). Continua sendo INCOME/EXPENSE
  // normal (afeta o saldo da conta), mas é excluída do faturamento/despesa
  // "real" em relatórios e no Balanço Executivo, para não duplicar no
  // consolidado.
  transferCompanyId String?
  transferCompany   Company? @relation("TransactionTransfer", fields: [transferCompanyId], references: [id], onDelete: SetNull)

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  scheduledEntry ScheduledEntry?
  cashClosing    CashClosing?

  @@index([companyId, date])
  @@index([accountId])
}

// Contas a pagar (PAYABLE) e a receber (RECEIVABLE) - lançamentos previstos.
// Ao serem baixados (status PAID), geram uma Transaction vinculada.
model ScheduledEntry {
  id          String          @id @default(cuid())
  type        ScheduledType
  description String
  amount      Decimal         @db.Decimal(14, 2)
  dueDate     DateTime
  status      ScheduledStatus @default(PENDING)
  paidDate    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([companyId, dueDate])
  @@index([status])
}

model ImportBatch {
  id           String   @id @default(cuid())
  fileName     String
  rowsImported Int
  createdAt    DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions Transaction[]
}

// Fechamento de caixa de um dia: agrega as sangrias (retiradas de cada
// caixa individual de atendente) e os pagamentos em dinheiro do dia,
// confronta o valor calculado (sangrias - pagamentos) com a contagem
// física, e gera uma única Transaction (soma das sangrias) para alimentar
// o resto do sistema. Pagamentos ficam só documentados aqui, sem gerar
// transação (o detalhe varia demais dia a dia).
model CashClosing {
  id          String   @id @default(cuid())
  date        DateTime
  countedCash Decimal  @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  lines CashClosingLine[]

  @@unique([companyId, date])
}

model CashClosingLine {
  id     String              @id @default(cuid())
  type   CashClosingLineType
  label  String
  amount Decimal             @db.Decimal(14, 2)
  order  Int

  cashClosingId String
  cashClosing   CashClosing @relation(fields: [cashClosingId], references: [id], onDelete: Cascade)
}

// Modelo de remuneração do médico: só consulta, consulta + exame, ou
// plantão pago por hora trabalhada (sem consulta/exame nenhum).
enum DoctorPaymentModel {
  CONSULTATION
  CONSULTATION_AND_EXAM
  HOURLY
}

// Médico com contrato de repasse. Em CONSULTATION/CONSULTATION_AND_EXAM,
// consultationRate é obrigatório (examRates só se aplica ao segundo). Em
// HOURLY, hourlyRate é obrigatório e consultationRate/examRates não se
// aplicam. "active" permite arquivar sem apagar o histórico de períodos já
// lançados. Sem integração automática com o razão financeiro por
// enquanto — é só controle/análise.
model Doctor {
  id               String             @id @default(cuid())
  name             String
  specialty        String             @default("Geral") // ex: Pediatra, Clínico Geral
  document         String? // CRM
  paymentMethod    String?
  paymentModel     DoctorPaymentModel @default(CONSULTATION_AND_EXAM)
  consultationRate Decimal?           @db.Decimal(14, 2)
  hourlyRate       Decimal?           @db.Decimal(14, 2) // plantão
  active           Boolean            @default(true)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  serviceRates  DoctorServiceRate[]
  periodReports DoctorPeriodReport[]
}

// Categoria semantica do item, usada pelas metricas (conversao = exames
// por consulta) e para saber o que faz sentido lancar.
enum ServiceCategory {
  CONSULTA
  EXAME
  PROCEDIMENTO
  PLANTAO
  OUTRO
}

// Convenio a que o item se aplica. 'Consulta CT' e 'Consulta Particular'
// sao itens distintos, com preco e repasse proprios.
enum Payer {
  CT
  PARTICULAR
}

// Item do catalogo de servicos da unidade: tudo que pode ser cobrado do
// paciente e/ou repassado a um medico — consulta, exame, procedimento,
// plantao, auxilio.
//
// price e operationalCost alimentam o calculo de margem (junto das faixas
// de taxa em TaxBracket); o repasse NAO fica aqui porque varia por medico
// — mora em DoctorServiceRate.
model ServiceItem {
  id              String          @id @default(cuid())
  name            String
  // Grupo operacional, que na pratica define o custo de insumo:
  // 'Proced de baixo custos', 'US', 'ECG e similares', 'Ortopedicos'...
  // Texto livre porque cada unidade organiza do seu jeito.
  group           String?
  category        ServiceCategory @default(EXAME)
  payer           Payer?
  // Valor cobrado do paciente. Nulo em item que nao gera receita direta
  // (plantao, auxilio combustivel).
  price           Decimal?        @db.Decimal(14, 2)
  operationalCost Decimal         @default(0) @db.Decimal(14, 2)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  doctorRates DoctorServiceRate[]
  reportLines DoctorPeriodExamCount[]

  @@unique([companyId, name])
}

// Faixa de taxa (cartao/antecipacao) aplicada conforme o valor cobrado do
// paciente — a planilha de exames usa um percentual diferente por faixa de
// preco. Fica como dado editavel por empresa, e nao formula chumbada no
// codigo, porque a negociacao com a maquininha muda e cada unidade pode ter
// a sua.
model TaxBracket {
  id        String   @id @default(cuid())
  minValue  Decimal  @db.Decimal(14, 2)
  maxValue  Decimal? @db.Decimal(14, 2) // nulo = sem teto
  percent   Decimal  @db.Decimal(5, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Taxa atual do médico para um tipo de exame — usada como valor-padrão ao
// lançar um novo período (o período guarda sua própria cópia congelada).
model DoctorServiceRate {
  id   String  @id @default(cuid())
  rate Decimal @db.Decimal(14, 2)

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  serviceItemId String
  serviceItem   ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)

  @@unique([doctorId, serviceItemId])
}

// Repasse agregado de um médico num mês: contagem de consultas (com a taxa
// congelada) + linhas de contagem por tipo de exame, OU (médico HOURLY)
// horas trabalhadas com a taxa/hora congelada. Os campos usados dependem
// do paymentModel do médico no momento do lançamento.
model DoctorPeriodReport {
  id                String   @id @default(cuid())
  competencia       DateTime // primeiro dia do mês de referência
  consultationCount Int?
  consultationRate  Decimal? @db.Decimal(14, 2) // congelada no lançamento
  hoursWorked       Decimal? @db.Decimal(8, 2) // plantão
  hourlyRate        Decimal? @db.Decimal(14, 2) // congelada no lançamento
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  examCounts DoctorPeriodExamCount[]

  @@unique([doctorId, competencia])
}

model DoctorPeriodExamCount {
  id    String  @id @default(cuid())
  count Int
  rate  Decimal @db.Decimal(14, 2) // congelada no lançamento

  reportId String
  report   DoctorPeriodReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  serviceItemId String
  serviceItem   ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)

  @@unique([reportId, serviceItemId])
}
