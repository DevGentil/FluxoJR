// Prisma schema - Sistema de Fluxo de Caixa (FluxoJR)
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntryType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  IMPORT
  SCHEDULED
}

enum ScheduledType {
  PAYABLE
  RECEIVABLE
}

enum ScheduledStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

// Marca/franquia da holding, agrupando várias empresas/unidades (ex:
// "AmorSaude" agrupa as franquias AS Laguna, AS Contagem, etc.).
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
}

// Empresa/unidade da holding (ex: uma franquia específica). Pode pertencer
// a um Group (marca) ou ficar solta.
model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  accounts        Account[]
  categories      Category[]
  suppliers       Supplier[]
  transactions    Transaction[]
  scheduledEntries ScheduledEntry[]
  importBatches   ImportBatch[]
  documents       Document[]

  incomingTransfers Transaction[] @relation("TransactionTransfer")
}

// Arquivo qualquer (contrato, documento societário, etc.) anexado a uma
// empresa. Conteúdo guardado direto no Postgres por simplicidade — sem
// depender de um storage externo configurado.
model Document {
  id          String   @id @default(cuid())
  fileName    String
  mimeType    String
  size        Int
  description String
  content     Bytes
  createdAt   DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Fornecedor/cliente da empresa, para enriquecer transações e contas a
// pagar/receber (ex: "DB Medicina Diagnóstica", "Amor Saude Franqueadora").
model Supplier {
  id        String   @id @default(cuid())
  name      String
  document  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  scheduledEntries ScheduledEntry[]
}

model Account {
  id             String   @id @default(cuid())
  name           String
  bank           String?
  type           String   @default("Conta Corrente")
  initialBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  scheduledEntries ScheduledEntry[]
}

model Category {
  id         String    @id @default(cuid())
  name       String
  type       EntryType
  costCenter String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  scheduledEntries ScheduledEntry[]
}

model Transaction {
  id          String            @id @default(cuid())
  date        DateTime
  amount      Decimal           @db.Decimal(14, 2)
  type        EntryType
  description String
  source      TransactionSource @default(MANUAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Marca esta transação como uma transferência de/para outra empresa do
  // grupo (ex: repasse entre franquias). Continua sendo INCOME/EXPENSE
  // normal (afeta o saldo da conta), mas é excluída do faturamento/despesa
  // "real" em relatórios e no Balanço Executivo, para não duplicar no
  // consolidado.
  transferCompanyId String?
  transferCompany   Company? @relation("TransactionTransfer", fields: [transferCompanyId], references: [id], onDelete: SetNull)

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  scheduledEntry ScheduledEntry?

  @@index([companyId, date])
  @@index([accountId])
}

// Contas a pagar (PAYABLE) e a receber (RECEIVABLE) - lançamentos previstos.
// Ao serem baixados (status PAID), geram uma Transaction vinculada.
model ScheduledEntry {
  id          String          @id @default(cuid())
  type        ScheduledType
  description String
  amount      Decimal         @db.Decimal(14, 2)
  dueDate     DateTime
  status      ScheduledStatus @default(PENDING)
  paidDate    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([companyId, dueDate])
  @@index([status])
}

model ImportBatch {
  id           String   @id @default(cuid())
  fileName     String
  rowsImported Int
  createdAt    DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions Transaction[]
}
