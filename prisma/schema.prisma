// Prisma schema - Sistema de Fluxo de Caixa (FluxoJR)
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntryType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  IMPORT
  SCHEDULED
}

enum ScheduledType {
  PAYABLE
  RECEIVABLE
}

enum ScheduledStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum CashClosingStatus {
  PENDENTE
  APROVADO
}

enum CashClosingLineType {
  SANGRIA
  PAGAMENTO
}

// Marca/franquia da holding, agrupando várias empresas/unidades (ex:
// "AmorSaude" agrupa as franquias AS Laguna, AS Contagem, etc.).
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
}

// Empresa/unidade da holding (ex: uma franquia específica). Pode pertencer
// a um Group (marca) ou ficar solta.
model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  accounts           Account[]
  categories         Category[]
  suppliers          Supplier[]
  transactions       Transaction[]
  scheduledEntries   ScheduledEntry[]
  importBatches      ImportBatch[]
  documents          Document[]
  cashClosings       CashClosing[]
  doctorPayouts      DoctorPayout[]
  dreReports         DreReport[]
  doctors            Doctor[]
  serviceItems       ServiceItem[]
  taxBrackets        TaxBracket[]
  doctorDailyEntries DoctorDailyEntry[]

  incomingTransfers Transaction[] @relation("TransactionTransfer")

  userAccess UserAccess[]
  periodClosings PeriodClosing[]
}

/// Conta de acesso ao sistema. A autenticacao continua no Supabase; aqui
/// mora o que o Supabase nao sabe: quem e a pessoa e o que ela pode fazer.
model AppUser {
  id        String   @id @default(cuid())
  /// Id do usuario no Supabase Auth — a ponte entre a sessao e a permissao.
  authId    String   @unique
  email     String   @unique
  name      String
  active    Boolean  @default(true)
  /// Acesso irrestrito a todas as empresas, presentes e futuras. Mora na
  /// conta e nao numa linha por empresa de proposito: fosse linha, unidade
  /// nova entraria invisivel para a diretoria ate alguem lembrar de dar
  /// acesso.
  holding   Boolean  @default(false)
  /// A senha atual foi definida por quem criou a conta, nao pelo dono dela.
  /// Volta a false quando a propria pessoa troca.
  senhaProvisoria Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  access UserAccess[]


  /// Quem cadastrou esta conta. Criar acesso e a operacao mais privilegiada
  /// do sistema, e ate o log de auditoria existir e o unico rastro dela.
  createdById String?
  createdBy   AppUser?  @relation("ContaCriadaPor", fields: [createdById], references: [id], onDelete: SetNull)
  criou       AppUser[] @relation("ContaCriadaPor")

  @@index([createdById])
}

/// O acesso de uma conta a UMA empresa, com o papel que ela exerce ali.
/// Papel por empresa, e nao global: a mesma pessoa pode ser gestora na
/// unidade dela e nao ter nada nas outras.
model UserAccess {
  id        String   @id @default(cuid())
  role      UserRole
  createdAt DateTime @default(now())

  userId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Os papeis dentro de uma unidade. Conta da holding nao usa este enum —
/// ela nao tem papel, tem ausencia de restricao.
enum UserRole {
  OPERACIONAL
  FINANCEIRO
  GESTOR
}

// Arquivo qualquer (contrato, documento societário, etc.) anexado a uma
// empresa. Conteúdo guardado direto no Postgres por simplicidade — sem
// depender de um storage externo configurado.
model Document {
  id          String   @id @default(cuid())
  fileName    String
  mimeType    String
  size        Int
  description String
  content     Bytes
  createdAt   DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Quando preenchido, o arquivo é do MÉDICO e aparece na ficha dele — o
  // contrato assinado, um aditivo, o diploma. Nulo é documento da empresa,
  // que é como todos nasceram.
  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  // Nota fiscal e comprovante do lancamento. Como o doctorId acima, sao
  // opcionais e mutuamente exclusivos na pratica: um arquivo pertence a um
  // lugar so. Nulo nos tres e documento solto da empresa.
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  scheduledEntryId String?
  scheduledEntry   ScheduledEntry? @relation(fields: [scheduledEntryId], references: [id], onDelete: Cascade)

  cashClosingId String?
  cashClosing   CashClosing? @relation(fields: [cashClosingId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([doctorId])
  @@index([transactionId])
  @@index([scheduledEntryId])
  @@index([cashClosingId])
}

// DRE realizado (fechado pelo contador/financeiro, ex: em Excel ou PDF) de
// um mês específico, guardado como referência ao lado do DRE que o sistema
// calcula automaticamente a partir das transações lançadas.
model DreReport {
  id          String   @id @default(cuid())
  competencia DateTime // primeiro dia do mês de referência
  fileName    String
  mimeType    String
  size        Int
  notes       String?
  content     Bytes
  createdAt   DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, competencia])
  @@index([companyId])
}

// Fornecedor/cliente da empresa, para enriquecer transações e contas a
// pagar/receber (ex: "DB Medicina Diagnóstica", "Amor Saude Franqueadora").
model Supplier {
  id        String   @id @default(cuid())
  name      String
  document  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  scheduledEntries ScheduledEntry[]
}

model Account {
  id             String   @id @default(cuid())
  name           String
  bank           String?
  type           String   @default("Conta Corrente")
  initialBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  scheduledEntries ScheduledEntry[]
  cashClosings     CashClosing[]
}

model Category {
  id         String    @id @default(cuid())
  name       String
  type       EntryType
  costCenter String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  scheduledEntries ScheduledEntry[]
}

model Transaction {
  id          String            @id @default(cuid())
  date        DateTime
  amount      Decimal           @db.Decimal(14, 2)
  type        EntryType
  description String
  source      TransactionSource @default(MANUAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Marca esta transação como uma transferência de/para outra empresa do
  // grupo (ex: repasse entre franquias). Continua sendo INCOME/EXPENSE
  // normal (afeta o saldo da conta), mas é excluída do faturamento/despesa
  // "real" em relatórios e no Balanço Executivo, para não duplicar no
  // consolidado.
  transferCompanyId String?
  transferCompany   Company? @relation("TransactionTransfer", fields: [transferCompanyId], references: [id], onDelete: SetNull)

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  scheduledEntry ScheduledEntry?
  documents      Document[]

  /// Preenchido quando a transacao nasceu da aprovacao de um fechamento.
  cashClosingId String?
  cashClosing   CashClosing? @relation(fields: [cashClosingId], references: [id], onDelete: Cascade)

  doctorPayout DoctorPayout?

  @@index([companyId, date])
  @@index([accountId])
  @@index([cashClosingId])
}

// Contas a pagar (PAYABLE) e a receber (RECEIVABLE) - lançamentos previstos.
// Ao serem baixados (status PAID), geram uma Transaction vinculada.
model ScheduledEntry {
  id          String          @id @default(cuid())
  type        ScheduledType
  description String
  amount      Decimal         @db.Decimal(14, 2)
  dueDate     DateTime
  status      ScheduledStatus @default(PENDING)
  paidDate    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  documents Document[]

  @@index([companyId, dueDate])
  @@index([status])
}

model ImportBatch {
  id           String   @id @default(cuid())
  fileName     String
  rowsImported Int
  createdAt    DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions Transaction[]
}

// Fechamento de caixa de um dia: agrega as sangrias (retiradas de cada
// caixa individual de atendente) e os pagamentos em dinheiro do dia,
// confronta o valor calculado (sangrias - pagamentos) com a contagem
// física, e gera uma única Transaction (soma das sangrias) para alimentar
// o resto do sistema. Pagamentos ficam só documentados aqui, sem gerar
// transação (o detalhe varia demais dia a dia).
model CashClosing {
  id          String   @id @default(cuid())
  date        DateTime
  countedCash Decimal  @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// So vira dinheiro no razao depois que o financeiro aprova. Ate la o
  /// fechamento existe, mostra a conferencia do dia e nao afeta nada.
  status     CashClosingStatus @default(PENDENTE)
  approvedAt DateTime?
  /// Nome COPIADO, como em PeriodClosing: aprovacao que perde o responsavel
  /// quando a conta sai deixa de responder "quem autorizou".
  approvedByName String?
  approvedById   String?

  /// Duas na aprovacao: a receita das sangrias e a despesa dos pagamentos.
  transactions Transaction[]

  lines     CashClosingLine[]
  documents Document[]

  @@unique([companyId, date])
}

model CashClosingLine {
  id     String              @id @default(cuid())
  type   CashClosingLineType
  label  String
  amount Decimal             @db.Decimal(14, 2)
  order  Int

  cashClosingId String
  cashClosing   CashClosing @relation(fields: [cashClosingId], references: [id], onDelete: Cascade)
}

// Médico com contrato de repasse. O contrato inteiro mora em
// DoctorServiceRate — uma linha por item que ele recebe (consulta CT,
// consulta particular, exame, procedimento, plantão, auxílio). Não existe
// "modelo de pagamento" fixo: as planilhas reais mostram médicos que
// combinam livremente plantão + consulta, ou consulta + auxílio
// combustível. "active" arquiva sem apagar o histórico.
model Doctor {
  id            String   @id @default(cuid())
  name          String
  specialty     String   @default("Geral")
  document      String? // CRM
  paymentMethod String?
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  serviceRates DoctorServiceRate[]
  dailyEntries DoctorDailyEntry[]
  documents    Document[]
  payouts      DoctorPayout[]
}

// Categoria semantica do item, usada pelas metricas (conversao = exames
// por consulta) e para saber o que faz sentido lancar.
enum ServiceCategory {
  CONSULTA
  EXAME
  PROCEDIMENTO
  PLANTAO
  OUTRO
}

// Convenio a que o item se aplica. 'Consulta CT' e 'Consulta Particular'
// sao itens distintos, com preco e repasse proprios.
enum Payer {
  CT
  PARTICULAR
}

// Item do catalogo de servicos da unidade: tudo que pode ser cobrado do
// paciente e/ou repassado a um medico — consulta, exame, procedimento,
// plantao, auxilio.
//
// price e operationalCost alimentam o calculo de margem (junto das faixas
// de taxa em TaxBracket); o repasse NAO fica aqui porque varia por medico
// — mora em DoctorServiceRate.
model ServiceItem {
  id              String          @id @default(cuid())
  name            String
  // Grupo operacional, que na pratica define o custo de insumo:
  // 'Proced de baixo custos', 'US', 'ECG e similares', 'Ortopedicos'...
  // Texto livre porque cada unidade organiza do seu jeito.
  group           String?
  category        ServiceCategory @default(EXAME)
  payer           Payer?
  // Valor cobrado do paciente. Nulo em item que nao gera receita direta
  // (plantao, auxilio combustivel).
  price           Decimal?        @db.Decimal(14, 2)
  operationalCost Decimal         @default(0) @db.Decimal(14, 2)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  doctorRates DoctorServiceRate[]
  dailyLines  DoctorDailyLine[]

  @@unique([companyId, name])
}

// Percentual que sai do valor cobrado do paciente conforme a faixa de preco
// — a planilha de exames usa um percentual diferente por faixa.
//
// O nome do modelo diz "Tax", mas o percentual NAO e so a taxa da
// maquininha: engloba tambem impostos e os demais custos proporcionais ao
// faturamento. Nas telas ele aparece como "encargos", que e o termo honesto;
// o identificador ficou como esta para nao arrastar uma migracao de nome
// atras de uma correcao de rotulo.
//
// Fica como dado editavel por empresa, e nao formula chumbada no codigo,
// porque a negociacao e a tributacao mudam e cada unidade pode ter a sua.
model TaxBracket {
  id        String   @id @default(cuid())
  minValue  Decimal  @db.Decimal(14, 2)
  maxValue  Decimal? @db.Decimal(14, 2) // nulo = sem teto
  percent   Decimal  @db.Decimal(5, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Taxa atual do médico para um tipo de exame — usada como valor-padrão ao
// lançar um novo período (o período guarda sua própria cópia congelada).
// Valor que UM médico recebe por UM item do catálogo. É o contrato: o
// mesmo procedimento pode ter valor diferente por médico (na planilha,
// Bioimpedância aparece a 60, 70 e 78 reais dependendo do nutricionista).
model DoctorServiceRate {
  id            String    @id @default(cuid())
  rate          Decimal   @db.Decimal(14, 2)
  // Desde quando ESTE valor vale. Um reajuste cria uma linha nova em vez de
  // sobrescrever: as planilhas trazem 13 reajustes reais em 11 médicos, e
  // sem vigência um dia de maio lançado depois de um reajuste de junho
  // congelava o valor errado. Ver lib/doctor-rates.ts.
  validFrom     DateTime
  // "Última conferência" da planilha: coluna que criaram e nunca
  // conseguiram manter preenchida.
  lastCheckedAt DateTime?

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  serviceItemId String
  serviceItem   ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)

  @@unique([doctorId, serviceItemId, validFrom])
  @@index([doctorId, serviceItemId, validFrom])
}

// Repasse agregado de um médico num mês: contagem de consultas (com a taxa
// congelada) + linhas de contagem por tipo de exame, OU (médico HOURLY)
// horas trabalhadas com a taxa/hora congelada. Os campos usados dependem
// do paymentModel do médico no momento do lançamento.
// Lançamento de um dia de trabalho do médico — é assim que a operação
// registra na prática: as 83 planilhas por médico têm uma linha por dia
// ("07/10  R$332"), agrupadas em uma aba por mês.
//
// O valor do dia vem de um de dois jeitos, e os dois convivem:
//  - `amount` preenchido: valor digitado direto, como na planilha. Serve
//    para importar o histórico e para quem não quer detalhar.
//  - `lines` preenchidas: o detalhe por item, e o valor é calculado pelo
//    contrato. Além de evitar erro de soma, é o que devolve a QUANTIDADE
//    de consultas e exames — sem ela não há taxa de conversão.
//
// Não há chave única por (médico, dia): nos dados reais existem 7 casos
// de dois lançamentos no mesmo dia (blocos diferentes da planilha).
model DoctorDailyEntry {
  id        String   @id @default(cuid())
  date      DateTime // dia do atendimento
  amount    Decimal? @db.Decimal(14, 2)
  // O "PG"/"PAGO" que a planilha anota na coluna de observação.
  paid      Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  lines DoctorDailyLine[]

  /// A que repasse aprovado este dia pertence. Nulo = ainda nao aprovado,
  /// e portanto ainda nao alimenta o razao.
  payoutId String?
  payout   DoctorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([companyId, date])
  @@index([doctorId, date])
  @@index([payoutId])
}

/// Repasse de um medico num mes, aprovado pelo financeiro.
///
/// A unidade e MEDICO x MES e nao o lancamento do dia, porque e assim que
/// o dinheiro sai: um pagamento por medico por mes. Uma transacao por dia
/// poria milhares de linhas no razao para representar um pagamento so.
model DoctorPayout {
  id             String   @id @default(cuid())
  /// Primeiro dia do mes, meia-noite UTC (a convencao de data do sistema).
  month          DateTime
  amount         Decimal  @db.Decimal(14, 2)
  approvedAt     DateTime @default(now())
  /// Nome copiado: a aprovacao precisa continuar respondendo "quem
  /// autorizou" depois que a conta sair.
  approvedByName String?
  approvedById   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  entries DoctorDailyEntry[]

  /// Sem `@@unique`: um dia esquecido lancado depois da aprovacao vira
  /// pagamento complementar, com aprovacao propria.
  @@index([companyId, doctorId, month])
  @@index([companyId, month])
}

// Detalhe opcional de um lançamento diário: quantos de um item foram
// feitos, com a taxa congelada no momento do lançamento — se o contrato
// mudar depois (e muda: são 13 reajustes reais nas planilhas), o
// histórico não se mexe.
model DoctorDailyLine {
  id       String  @id @default(cuid())
  quantity Decimal @db.Decimal(10, 2)
  rate     Decimal @db.Decimal(14, 2)

  entryId String
  entry   DoctorDailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  serviceItemId String
  serviceItem   ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)

  @@unique([entryId, serviceItemId])
}

/// Erro que estourou em producao, capturado pelo hook `onRequestError` do
/// Next. Existe para responder "o sistema quebrou para alguem?" sem depender
/// de a pessoa avisar — que ate aqui era a unica forma de descobrir.
enum ErrorSeverity {
  CRITICO
  ERRO
  AVISO
}

model ErrorLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  message String
  /// O mesmo codigo que a tela de erro mostra ao usuario ("Codigo para
  /// suporte"). E o que liga o print que a pessoa manda a linha daqui.
  digest  String?
  stack   String?
  route   String?
  method  String?
  /// Marcado quando alguem da holding le. O aviso no Dashboard conta os nao
  /// vistos — erro que ninguem olhou e erro que ninguem tratou.
  seen    Boolean  @default(false)
  /// Quao grave, do ponto de vista de quem vai agir: o sistema esta fora,
  /// uma operacao falhou, ou funcionou como devia. Classificada na hora de
  /// gravar por `lib/erro-gravidade.ts`.
  severity ErrorSeverity @default(ERRO)

  @@index([at])
  @@index([seen])
  @@index([severity])
}

/// Quem alterou o que, e quando.
///
/// Nome da pessoa e da empresa ficam COPIADOS aqui, e nao como chave
/// estrangeira. Nao e desnormalizacao por descuido: um registro de auditoria
/// que perde o sujeito quando a conta e removida deixa de ser auditoria. O
/// `userId` fica junto so para agrupar, e pode apontar para o vazio.
model AuditLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())

  userId      String?
  userName    String
  userEmail   String

  /// Nulo quando o evento e do SISTEMA e nao de uma unidade: criar uma conta
  /// de holding, por exemplo, nao acontece "dentro" de empresa nenhuma.
  /// Preferivel a inventar uma empresa so para preencher a coluna.
  companyId   String?
  companyName String?

  /// Modulo do sistema, como em lib/permissions.ts.
  module      String
  /// O verbo, em portugues e no passado: "alterou", "excluiu", "aprovou".
  acao        String
  /// Do que se trata, ja legivel: "Contrato de Dr. Carlos Andrade".
  entidade    String
  /// O que mudou, em uma linha: "ECG: R$ 45,00 -> R$ 25,00".
  resumo      String
  /// Id do registro afetado, para quem quiser cruzar com a tabela de origem.
  registroId  String?

  @@index([at])
  @@index([companyId, at])
  @@index([userId])
}

/// Mes fechado de uma unidade.
///
/// Ate aqui `paid` marcava que o repasse foi pago, mas nao impedia nada: os
/// 1.981 lancamentos ja pagos de janeiro a julho seguiam editaveis e
/// apagaveis. Marcar nao e proteger — a linha aqui e o que protege.
model PeriodClosing {
  id    String   @id @default(cuid())
  /// Primeiro dia do mes, meia-noite UTC (a convencao de data do sistema).
  month DateTime

  closedAt     DateTime @default(now())
  /// Nome copiado, como no log de auditoria: quem fechou o mes precisa
  /// continuar respondido depois que a conta sair.
  closedByName String
  closedById   String?
  notes        String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month])
  @@index([companyId, month])
}
